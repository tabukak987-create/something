# ──────────────────────────────────────────────────
# PF Trust — Root .gitignore for Private3
# ──────────────────────────────────────────────────

# Environment / secrets — NEVER commit these
.env
**/.env
*.env
.env.secrets
**/.env.secrets
.env.local
**/.env.local

# SSL certificates — NEVER commit private keys
nginx/ssl/
**/*.pem
**/*.key
**/*.crt
**/*.p12

# Python bytecode
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Exported data
*.sqlite_export.json

# Logs
*.log
logs/
**/logs/

# IDE / OS
.vscode/
.idea/
.pytest_cache/
*.DS_Store
Thumbs.db

# Report output
reports/output/
**/reports/output/

# Google OAuth tokens (NEVER commit)
token.json
**/token.json
client_secret_*.json
email_config.json

# Generated artifacts and reports
*.pdf
*.xlsx
*.jsonl
*_raw_results.json
*_results.json
*_report.json
*_rating_update_report.json
*_log*.txt
*_out*.txt
*_err*.txt
*_live*.txt
*_restart*.txt
tmp_*.py

# Generated output directories
/reports/
/bond_quote_system/reports/
/bond_intelligence/reports/
/investment_engine/reports/
/data/
/backups/
/backup_evidence/
/test-results/

