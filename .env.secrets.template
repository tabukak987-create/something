# ═══════════════════════════════════════════════════════════════════════
# PF Trust Bond Platform — SECRETS TEMPLATE
# ═══════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
#   1. Copy this file to .env.secrets (excluded from git via .gitignore)
#   2. Fill in ALL values below
#   3. All passwords MUST meet: ≥12 chars, upper + lower + digit + special
#   4. Generate JWT secret: python -c "import secrets; print(secrets.token_hex(32))"
#   5. Rotate all secrets every 90 days
#
# FOR PRODUCTION:
#   Inject these via HashiCorp Vault, AWS Secrets Manager, or Azure Key Vault.
#   Do NOT use .env.secrets files in production containers.
# ═══════════════════════════════════════════════════════════════════════

# JWT (generate: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=

# Local admin login for the reconstructed app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# PostgreSQL — Gateway DB
GATEWAY_DB_URL=postgresql+asyncpg://gw_user:<PASSWORD>@127.0.0.1:5432/bond_gateway_db

# PostgreSQL — Compliance DB
COMPLIANCE_DB_URL=postgresql+asyncpg://compliance:<PASSWORD>@localhost:5432/compliance_db

# Initial admin credentials (forced change on first login)
GATEWAY_ADMIN_PASSWORD=
GATEWAY_VIEWER_PASSWORD=

# PgAdmin (only for --profile tools)
PGADMIN_EMAIL=admin@bond-gateway.in
PGADMIN_PASSWORD=

# Grafana (only for --profile monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Backup encryption
BACKUP_ENCRYPTION_KEY=

# PostgreSQL backup passwords (set as machine-level env vars for scheduled tasks)
# PGPASSWORD_GATEWAY=
# PGPASSWORD_COMPLIANCE=
